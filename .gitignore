# Symbiont runtime state (includes per-engagement private keys under .symbiont/keys/)
.symbiont/

# Ed25519 private keys must never be committed
*.priv

# Deployment-specific producer keyring (commit keys/producers.toml.example instead)
keys/producers.toml

# Scan output (persisted via docker-compose volumes)
audit-logs/
scan-results/

# Rust build artifacts
target/
Cargo.lock

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment (secrets should use a secrets manager, not env files)
.env
.env.local

# Python bytecode
__pycache__/
*.pyc

# Docker volumes (persisted outside repo)
data/
evidence/
reports/

# Local symbiont build (symlinked for docker build)
symbiont/

# Superpowers working files
docs/superpowers/
docs/plans/

# Worktrees
.worktrees/
